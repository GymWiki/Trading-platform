# --- App ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (MySQL, e.g. PlanetScale / Hetzner-hosted MySQL) ---
DATABASE_URL="mysql://user:password@localhost:3306/freqtrade_saas"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring "per bot" price (quantity-based subscription line item)
STRIPE_VPS_BOT_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Hetzner Cloud ---
HETZNER_API_TOKEN=""
HETZNER_SSH_KEY_ID=""
HETZNER_SERVER_TYPE="cx11"
HETZNER_LOCATION="nbg1"
HETZNER_IMAGE="ubuntu-24.04"

# --- Encryption (AES-256-GCM key for exchange API secrets) ---
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- File storage for uploaded .joblib models ---
# "local" writes to /public/uploads (dev only). Swap for S3/R2 in production.
UPLOAD_STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# --- Desktop app download links (placeholders until installers are built) ---
NEXT_PUBLIC_DESKTOP_APP_WINDOWS_URL="https://downloads.example.com/freqtrade-command-center-setup.exe"
NEXT_PUBLIC_DESKTOP_APP_MAC_URL="https://downloads.example.com/freqtrade-command-center.dmg"
