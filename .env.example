# --- Hetzner Cloud ---
HETZNER_API_TOKEN=""
HETZNER_SSH_KEY_ID=""
HETZNER_SERVER_TYPE="cx11"
# Bigger/pricier instance used only for ephemeral FreqAI cloud training runs.
HETZNER_TRAINING_SERVER_TYPE="cpx31"
HETZNER_LOCATION="nbg1"
HETZNER_IMAGE="ubuntu-24.04"

# --- Encryption (AES-256-GCM key for exchange API secrets) ---
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Cron auth (Vercel Cron -> GET /api/train/cloud/reap, see vercel.json) ---
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` to
# scheduled functions once this is set. generate with: openssl rand -hex 32
CRON_SECRET=""

