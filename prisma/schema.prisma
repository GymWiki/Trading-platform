generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- App models --------------------------------------------------------

// Mirrors public.profiles in Supabase: one row per auth.users row, created
// automatically by the on_auth_user_created trigger. Supabase Auth (GoTrue)
// owns credentials/passwords in the auth schema — never modeled here.
model Profile {
  id String @id @db.Uuid

  name String?

  // Stripe billing
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  vpsBotQuota          Int     @default(0) @map("vps_bot_quota")

  bots BotConfiguration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

enum DeploymentStatus {
  LOCAL
  VPS_ACTIVE
  INACTIVE
}

// How the user currently wants to train this bot's FreqAI model. Purely a
// UI preference — the actual run history lives in TrainingJob.
enum TrainingMode {
  LOCAL
  CLOUD
}

enum TrainingStatus {
  QUEUED
  TRAINING
  COMPLETED
  FAILED
}

// Operational lifecycle of the bot itself — distinct from TrainingStatus,
// which tracks a single training run. TRAINING/UPDATING_MODEL are the
// statuses that must never overlap with live trading: see
// lib/bot-status.ts (canTrade/assertCanTrade), which every code path that
// could start or resume trading is required to check.
//   IDLE           not yet deployed, or deployed but intentionally stopped
//   TRAINING       first-ever model training in progress, not deployed yet
//   TRADING        deployed and actively trading (or paper trading)
//   UPDATING_MODEL was TRADING, now paused while a retrain is in progress
//   ERROR          a deploy, training, or pause/resume action failed
enum BotStatus {
  IDLE
  TRAINING
  TRADING
  UPDATING_MODEL
  ERROR
}

model BotConfiguration {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  botName      String @map("bot_name")
  exchangeName String @map("exchange_name")

  // Encrypted at rest (see lib/encryption.ts) — never returned to the client in plaintext.
  exchangeApiKey    String @map("exchange_api_key")
  exchangeApiSecret String @map("exchange_api_secret")

  strategy String
  // The actual Freqtrade strategy source (must define `class <strategy>`),
  // written into user_data/strategies/<strategy>.py on every VPS this bot
  // is deployed or trained on — without it, the container has nothing to
  // load and fails at startup.
  strategyCode  String  @map("strategy_code")
  // Every bot runs on FreqAI — this is the structured training/feature/risk
  // config for the chosen AI behavior (see lib/strategy-presets.ts
  // FreqAIProfileConfig), captured at creation time so lib/hetzner.ts can
  // build the real freqai config.json block from it on every (re)deploy or
  // training run, rather than from generic hardcoded defaults.
  freqaiConfig  Json    @map("freqai_config")
  pairWhitelist String  @map("pair_whitelist") // comma-separated pairs, e.g. "BTC/USDT,ETH/USDT"
  // The total amount (in stake_currency) this bot is allowed to put to work
  // across all its open trades. Freqtrade itself is told stake_amount is
  // "unlimited" (see lib/hetzner.ts) — sizing per trade is real Python logic
  // in custom_stake_amount, not a fixed number in config.json.
  totalBudget        Float @map("total_budget")
  // Hard ceiling, as a percentage of totalBudget, that custom_stake_amount
  // is allowed to put into a single trade even at maximum FreqAI confidence.
  // UI: a 10-100 slider defaulting to 20 (see components/ui/BudgetSlider.tsx).
  maxStakePercentage Float @default(20) @map("max_stake_percentage")
  isPaperTrading Boolean @default(true) @map("is_paper_trading")

  deploymentStatus DeploymentStatus @default(LOCAL) @map("deployment_status")
  aiModelPath      String?          @map("ai_model_path")

  hetznerServerId String? @map("hetzner_server_id")
  hetznerServerIp String? @map("hetzner_server_ip")

  // Randomized per deployment (see /api/deploy) so the freqtrade REST API
  // exposed on the VPS never ships with the same guessable default
  // credentials on every bot. Encrypted at rest like the exchange keys.
  apiServerUsername String? @map("api_server_username")
  apiServerPassword String? @map("api_server_password")
  apiServerJwtSecret String? @map("api_server_jwt_secret")

  status    BotStatus @default(IDLE) @map("status")
  lastError String?   @map("last_error")
  // sha256 of the one-time bearer token given to the *deployed* freqtrade
  // instance (via user_data/webhook.json), letting it call back into
  // POST /api/bots/[id]/status without a user session. Rotated on every
  // (re)deploy. Distinct from TrainingJob.callbackTokenHash, which
  // authenticates the ephemeral *training* VM instead.
  statusWebhookTokenHash String? @unique @map("status_webhook_token_hash")

  trainingMode TrainingMode    @default(LOCAL) @map("training_mode")
  trainingJobs TrainingJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("bot_configurations")
}

// One row per training attempt (local upload or cloud run), so status/errors
// for an in-progress or past run can be surfaced in the dashboard.
model TrainingJob {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  botId  String           @map("bot_id") @db.Uuid
  bot    BotConfiguration @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId String           @map("user_id") @db.Uuid

  mode   TrainingMode
  status TrainingStatus @default(QUEUED)

  // sha256 of the one-time bearer token handed to the ephemeral training VM
  // so it can report status back without holding a real user session.
  callbackTokenHash String @unique @map("callback_token_hash")

  hetznerServerId String? @map("hetzner_server_id")
  errorMessage    String? @map("error_message")
  aiModelPath     String? @map("ai_model_path")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([botId])
  @@index([status])
  @@map("training_jobs")
}
