generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- App models --------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  // bcrypt hash — never selected into API responses in plaintext.
  password String

  // Stripe billing
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  vpsBotQuota          Int     @default(0) @map("vps_bot_quota")

  bots BotConfiguration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum DeploymentStatus {
  LOCAL
  VPS_ACTIVE
  INACTIVE
}

model BotConfiguration {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  botName      String @map("bot_name")
  exchangeName String @map("exchange_name")

  // Encrypted at rest (see lib/encryption.ts) — never returned to the client in plaintext.
  exchangeApiKey    String @map("exchange_api_key") @db.Text
  exchangeApiSecret String @map("exchange_api_secret") @db.Text

  strategy       String
  pairWhitelist  String @map("pair_whitelist") @db.Text // comma-separated pairs, e.g. "BTC/USDT,ETH/USDT"
  stakeAmount    Float  @map("stake_amount")
  isPaperTrading Boolean @default(true) @map("is_paper_trading")

  deploymentStatus DeploymentStatus @default(LOCAL) @map("deployment_status")
  aiModelPath      String?          @map("ai_model_path")

  hetznerServerId String? @map("hetzner_server_id")
  hetznerServerIp String? @map("hetzner_server_ip")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("bot_configurations")
}
