generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- App models --------------------------------------------------------

// Mirrors public.profiles in Supabase: one row per auth.users row, created
// automatically by the on_auth_user_created trigger. Supabase Auth (GoTrue)
// owns credentials/passwords in the auth schema — never modeled here.
model Profile {
  id String @id @db.Uuid

  name String?

  // Stripe billing
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  vpsBotQuota          Int     @default(0) @map("vps_bot_quota")

  // One Telegram chat per user (not per bot) — connect once, every bot's
  // config.json gets our central bot token + this chat_id injected on
  // deploy (see lib/hetzner.ts). Null until the user links their account.
  telegramChatId String? @map("telegram_chat_id")

  // Bumped on real user activity (dashboard load — see app/dashboard/page.tsx);
  // Sleep Mode's daily sweep (app/api/bots/sleep-sweep) compares this
  // against a 7-day cutoff before stopping a bot's VPS container.
  lastActiveAt DateTime? @default(now()) @map("last_active_at")

  bots                BotConfiguration[]
  exchangeConnections ExchangeConnection[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

enum DeploymentStatus {
  LOCAL
  VPS_ACTIVE
  INACTIVE
}

// How the user currently wants to train this bot's FreqAI model. Purely a
// UI preference — the actual run history lives in TrainingJob.
enum TrainingMode {
  LOCAL
  CLOUD
}

enum TrainingStatus {
  QUEUED
  TRAINING
  COMPLETED
  FAILED
}

// Operational lifecycle of the bot itself — distinct from TrainingStatus,
// which tracks a single training run. TRAINING/UPDATING_MODEL are the
// statuses that must never overlap with trading (paper or live): see
// lib/bot-status.ts (canTrade/assertCanTrade), which every code path that
// could start or resume trading is required to check.
//
// "Try before you risk": every bot is born (and stays) in
// TRAINING_PAPER_TRADE until the user explicitly clears the Go Live flow
// (see app/api/bots/[id]/golive) — there is no separate "not deployed yet"
// status anymore, since paper trading carries no financial risk to gate.
//   TRAINING_PAPER_TRADE  default from creation onward — not yet deployed,
//                         mid first-training, or deployed and dry-run
//                         trading. isPaperTrading is true throughout.
//   TRAINING              first-ever model training in progress
//   LIVE_TRADING          cleared Go Live — deployed with real funds,
//                         isPaperTrading is false
//   UPDATING_MODEL        was TRAINING_PAPER_TRADE or LIVE_TRADING, now
//                         paused while a retrain is in progress; resumes
//                         to whichever it was (see lib/deploy-bot.ts,
//                         which derives the resume status from
//                         isPaperTrading rather than hardcoding one)
//   ERROR                 a deploy, training, or pause/resume action failed
//   PAUSED_EMERGENCY       the user hit the Panic Button (POST
//                         /api/bots/panic) — every open position was
//                         market-force-closed and the bot paused. Never
//                         resumed automatically by anything (see
//                         lib/bot-status.ts); only POST
//                         /api/bots/[id]/resume, a deliberate user action,
//                         clears it.
//   SLEEPING               auto-paused by the Sleep Mode daily sweep
//                         (paper-trading bots only, 7+ days of user
//                         inactivity) — the Hetzner Docker container is
//                         stopped (not deleted) to save cost. Resumed the
//                         same way as PAUSED_EMERGENCY.
enum BotStatus {
  TRAINING_PAPER_TRADE
  TRAINING
  LIVE_TRADING
  UPDATING_MODEL
  ERROR
  PAUSED_EMERGENCY
  SLEEPING
}

// A user's linked exchange account — added credentials once, reused by any
// number of bots. Splitting this out of BotConfiguration (which used to
// hold its own exchangeApiKey/exchangeApiSecret) is what makes the
// /platforms "connect once, see your balance" flow and the Go Live balance
// check possible: both need to query a real exchange balance independent
// of any particular bot.
model ExchangeConnection {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Closed list validated against EXCHANGE_PRESETS ids (see
  // lib/exchange-presets.ts) at the API boundary — kept a plain String
  // rather than a native Postgres enum so the exchange list (which also
  // carries fee/logo metadata) has exactly one source of truth, matching
  // how BotConfiguration.exchangeName already worked before this model existed.
  exchangeName String @map("exchange_name")

  // Encrypted at rest via lib/encryption.ts (AES-256-GCM) — the same
  // mechanism BotConfiguration's exchange credentials already used before
  // they moved here. A future move to Supabase Vault would replace this
  // column pair with vault secret references without touching callers,
  // since lib/encryption.ts is already the single choke point every
  // encrypt/decrypt call goes through.
  apiKey    String @map("api_key")
  apiSecret String @map("api_secret")

  isActive Boolean @default(true) @map("is_active")

  bots BotConfiguration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, exchangeName])
  @@index([userId])
  @@map("exchange_connections")
}

model BotConfiguration {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  botName String @map("bot_name")

  // The linked account whose credentials this bot trades with (see
  // ExchangeConnection above) — replaces the per-bot exchangeApiKey/
  // exchangeApiSecret this model used to carry directly. onDelete: Restrict
  // so removing a connection that's still backing a bot fails loudly
  // (app/api/platforms/[id]/route.ts checks this before attempting the
  // delete) rather than orphaning a deployed bot's credentials.
  exchangeConnectionId String             @map("exchange_connection_id") @db.Uuid
  exchangeConnection   ExchangeConnection @relation(fields: [exchangeConnectionId], references: [id], onDelete: Restrict)
  // Denormalized copy of exchangeConnection.exchangeName at creation time —
  // read in many places (lib/hetzner.ts, fee lookups, display) that don't
  // otherwise need to join the connection, and immutable for the bot's
  // lifetime since swapping a bot's exchange isn't supported.
  exchangeName String @map("exchange_name")

  strategy String
  // The actual Freqtrade strategy source (must define `class <strategy>`),
  // written into user_data/strategies/<strategy>.py on every VPS this bot
  // is deployed or trained on — without it, the container has nothing to
  // load and fails at startup.
  strategyCode  String  @map("strategy_code")
  // Every bot runs on FreqAI — this is the structured training/feature/risk
  // config for the chosen AI behavior (see lib/strategy-presets.ts
  // FreqAIProfileConfig), captured at creation time so lib/hetzner.ts can
  // build the real freqai config.json block from it on every (re)deploy or
  // training run, rather than from generic hardcoded defaults.
  freqaiConfig  Json    @map("freqai_config")
  // When true (the default), pairWhitelist is ignored and lib/hetzner.ts
  // configures freqtrade's VolumePairList instead of a static list — FreqAI
  // dynamically trades whatever the exchange's own top-liquid USDT markets
  // are at the time, re-evaluated on freqtrade's own refresh_period.
  autoSelectCoins Boolean @default(true) @map("auto_select_coins")
  // The user's manual pair selection. Only required (and only read) when
  // autoSelectCoins is false — null/empty whenever auto-select is on.
  pairWhitelist String? @map("pair_whitelist") // comma-separated pairs, e.g. "BTC/USDT,ETH/USDT"
  // Null until the user clears the Go Live flow (see
  // app/api/bots/[id]/golive) — every bot starts and stays in paper trading
  // with no real budget at stake, so there's nothing real to size until
  // then. lib/hetzner.ts falls back to a fixed virtual paper-trading wallet
  // (see DEFAULT_PAPER_TOTAL_BUDGET) whenever this is null, so dry-run
  // performance still means something.
  //
  // The total amount (in stake_currency) this bot is allowed to put to work
  // across all its open trades. Freqtrade itself is told stake_amount is
  // "unlimited" (see lib/hetzner.ts) — sizing per trade is real Python logic
  // in custom_stake_amount, not a fixed number in config.json.
  totalBudget Float? @map("total_budget")
  // Hard ceiling, as a percentage of totalBudget, that custom_stake_amount
  // is allowed to put into a single trade even at maximum FreqAI confidence.
  // Also null until Go Live — UI: a 10-100 slider (components/ui/BudgetSlider.tsx).
  maxStakePercentage Float? @map("max_stake_percentage")
  // Always true at creation (bots start in paper trading, no exceptions) —
  // flips to false exactly once, via the Go Live flow, never back.
  isPaperTrading Boolean @default(true) @map("is_paper_trading")

  // Snowball mode: when true, lib/hetzner.ts computes a real
  // tradable_balance_ratio from the live exchange balance at deploy time
  // and the strategy's custom_stake_amount sizes off the live wallet
  // instead of the fixed totalBudget snapshot, so profits compound into
  // future position sizes rather than sitting idle. Off by default —
  // matches today's behavior (sizing pinned to totalBudget) exactly.
  autoCompound Boolean @default(false) @map("auto_compound")

  deploymentStatus DeploymentStatus @default(LOCAL) @map("deployment_status")
  aiModelPath      String?          @map("ai_model_path")

  hetznerServerId String? @map("hetzner_server_id")
  hetznerServerIp String? @map("hetzner_server_ip")

  // Randomized per deployment (see /api/deploy) so the freqtrade REST API
  // exposed on the VPS never ships with the same guessable default
  // credentials on every bot. Encrypted at rest like the exchange keys.
  apiServerUsername String? @map("api_server_username")
  apiServerPassword String? @map("api_server_password")
  apiServerJwtSecret String? @map("api_server_jwt_secret")

  status    BotStatus @default(TRAINING_PAPER_TRADE) @map("status")
  lastError String?   @map("last_error")
  // sha256 of the one-time bearer token given to the *deployed* freqtrade
  // instance (via user_data/webhook.json), letting it call back into
  // POST /api/bots/[id]/status without a user session. Rotated on every
  // (re)deploy. Distinct from TrainingJob.callbackTokenHash, which
  // authenticates the ephemeral *training* VM instead.
  statusWebhookTokenHash String? @unique @map("status_webhook_token_hash")

  trainingMode TrainingMode    @default(LOCAL) @map("training_mode")
  trainingJobs TrainingJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("bot_configurations")
}

// One row per training attempt (local upload or cloud run), so status/errors
// for an in-progress or past run can be surfaced in the dashboard.
model TrainingJob {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  botId  String           @map("bot_id") @db.Uuid
  bot    BotConfiguration @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId String           @map("user_id") @db.Uuid

  mode   TrainingMode
  status TrainingStatus @default(QUEUED)

  // sha256 of the one-time bearer token handed to the ephemeral training VM
  // so it can report status back without holding a real user session.
  callbackTokenHash String @unique @map("callback_token_hash")

  hetznerServerId String? @map("hetzner_server_id")
  errorMessage    String? @map("error_message")
  aiModelPath     String? @map("ai_model_path")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([botId])
  @@index([status])
  @@map("training_jobs")
}
